            "core/comment-reply-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--hang-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--hang-small)"
                }
