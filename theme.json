    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "link": {
                        "border": {
                            "color": "transparent",
                            "radius": "0px",
                            "style": "none",
                            "width": "0"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--hang-neutral-darkest)"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        },
                        "typography": {
                            "textDecoration": "underline"
                        }
                    },
                    "alternative": {
                        "border": {
                            "color": "transparent",
                            "radius": "100px",
                            "style": "solid",
                            "width": "2px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--hang-neutral-darkest)"
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--hang-neutral-lightest)",
                    "text": "var(--wp--preset--color--hang-neutral-darkest)"
