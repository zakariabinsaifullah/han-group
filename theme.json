                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--hang-40)",
                        "left": "var(--wp--preset--spacing--hang-40)",
                        "right": "var(--wp--preset--spacing--hang-40)",
                        "top": "var(--wp--preset--spacing--hang-40)"
                    }
                },
                "typography": {
                    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
                    "fontSize": "var(--wp--preset--font-size--hang-medium)",
                    "fontWeight": "300"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--hang-50)"
                }
            },
            "core/comment-author-name": {
                "color": {
                    "text": "var(--wp--preset--color--hang-neutral-dark)"
