                }
            },
            "core/comments-pagination-previous": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--hang-medium)"
                }
            },
            "core/list": {
                "css": "& li{margin-top: 0.5rem;}"
            },
            "core/navigation": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--hang-medium)"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--montserrat)",
                    "fontSize": "var(--wp--preset--font-size--hang-large)",
                    "lineHeight": "1.5"
                },
                "color": {
                    "text": "var(--wp--preset--color--hang-neutral-darker)"
                }
            },
            "core/post-comments-form": {
                "css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: var(--wp--preset--color--hang-neutral-lighter) !important;} & input[type=checkbox]{margin:0 .2rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--hang-small); }",
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--hang-40)",
                        "top": "var(--wp--preset--spacing--hang-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--hang-medium)"
                }
            },
            "core/post-date": {
                "color": {
                    "text": "var(--wp--preset--color--hang-neutral-dark)"
